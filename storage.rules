rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // IELTS listening audio — public read
    match /ielts/listening/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // User uploads (optional future)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
