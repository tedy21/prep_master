rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profile + progress: owner only
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Curated questions / mock tests / vocab / guides: public read, admin write
    match /quiz_questions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /content_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /questions/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /mock_tests/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /vocabulary/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /college_guides/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Leaderboard: read all, write own entry
    match /leaderboard/global/entries/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /leaderboard/weekly/{weekId}/entries/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
